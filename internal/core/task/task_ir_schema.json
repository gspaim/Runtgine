{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://runtgine.dev/schemas/task-ir-v0.1.0.json",
  "title": "Runtgine Task IR v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "intent", "steps"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_point"],
      "properties": {
        "entry_point": {
          "type": "string",
          "enum": ["cli", "tui", "board", "api", "other"]
        },
        "ref": {
          "type": "string"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary"],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step_id", "capability", "input"],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 3
          },
          "input": {
            "type": "object"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "max_retries": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    }
  }
}
